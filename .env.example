APP_DATA_DIR=/data
APP_DB_PATH=/db/app.db
# Optional full SQLAlchemy URL. SQLite is the only database supported by startup migrations.
# DATABASE_URL=sqlite:////db/app.db
APP_TIMEZONE=Europe/Moscow
SCHEDULER_TICK_SECONDS=30
SCAN_TICK_SECONDS=120
MAX_CAPTION_LENGTH=1024
PREVIEW_BATCH_SIZE=24
# Optional: if left empty, the app will generate a secret and store it in /data/.session_secret
APP_SESSION_SECRET=
APP_SESSION_HTTPS_ONLY=false
